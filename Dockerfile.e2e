# Dockerfile for E2E test worker
# Runs Celery worker with test tasks and stemtrace integration

# Install the runtime dependencies pinned in uv.lock into a virtualenv
FROM python:3.12.16-slim-trixie@sha256:8523d6abeb48ceae0b7240d30c5808fc26cb79c1a635bacdf19cf3baecfbec07 AS builder

COPY --from=ghcr.io/astral-sh/uv:0.12.18@sha256:3adc3706091ce7c2fe595e669628caedd6d951551b92b258b7e7dbe06d9440bc /uv /usr/local/bin/uv
ENV UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_NO_CACHE=1

WORKDIR /src
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-build --no-install-project && rm -f /opt/venv/.lock

FROM python:3.12.16-slim-trixie@sha256:8523d6abeb48ceae0b7240d30c5808fc26cb79c1a635bacdf19cf3baecfbec07

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy the stemtrace package source (used directly, no package build)
COPY src/stemtrace/ /app/stemtrace/

# Make it importable as a package
ENV PYTHONPATH=/app

# Copy test tasks (they'll also be mounted as volume for live changes)
COPY tests/e2e/ /app/tests/e2e/

# Run as an unprivileged user
RUN useradd --create-home --uid 1000 stemtrace
USER stemtrace

# Default command - note the task events flag to help debug
CMD ["celery", "-A", "tests.e2e.tasks", "worker", "--loglevel=info", "-E"]
